---
import '../styles/global.css';
import '../styles/accessibility.css';
import '../styles/theme-fix.css';
import { getSiteSettings } from '../lib/sanity';

const {
  title = 'VNH | Parts, Solutions, Ideas & Freedom',
  description = 'VNH creates practical products, useful solutions, and original ideas for people who value freedom and personal responsibility.',
  canonical,
  noindex = false,
  ogType = 'website',
  socialImage,
  structuredData
} = Astro.props;

const runtimeEnv = (Astro.locals as any)?.runtime?.env ?? import.meta.env;
const siteSettings = await getSiteSettings(runtimeEnv);
const text = (value: string | undefined, fallback: string) => value?.trim() || fallback;
const brandName = text(siteSettings.brandName, 'VNH');
const configuredBrandTagline = text(siteSettings.brandTagline, 'Engineered Design');
const brandTagline = configuredBrandTagline.toUpperCase() === 'REAL PEOPLE. REAL PURPOSE.'
  ? 'Engineered Design'
  : configuredBrandTagline;
const companyName = 'VNH Engineered Design';
const navShopLabel = text(siteSettings.navShopLabel, 'Shop');
const navContactLabel = text(siteSettings.navContactLabel, 'Contact');
const browseShopAriaLabel = text(siteSettings.browseShopAriaLabel, 'Browse shop');
const accountAriaLabel = text(siteSettings.accountAriaLabel, 'Account');
const cartAriaLabel = text(siteSettings.cartAriaLabel, 'Cart');
const configuredFooterText = text(siteSettings.footerText, companyName);
const footerText = configuredFooterText.toUpperCase() === 'VNH. REAL PEOPLE. REAL PURPOSE.'
  ? companyName
  : configuredFooterText;
const footerShopLabel = text(siteSettings.footerShopLabel, 'Shop');
const footerContactLabel = text(siteSettings.footerContactLabel, 'Contact');
const logoSrc = siteSettings.logoUrl || '/vnh-logo-clean.svg';
const topoSrc = siteSettings.topoUrl || '/vnh-topo-simple.svg';
const siteOrigin = Astro.site ?? new URL('https://vnhofficial.com');
const canonicalUrl = canonical ? new URL(canonical, siteOrigin).toString() : new URL(Astro.url.pathname, siteOrigin).toString();
const socialImageSource = socialImage || siteSettings.socialShareUrl;
const socialImageUrl = socialImageSource ? new URL(socialImageSource, siteOrigin).toString() : undefined;
const googleSiteVerification = runtimeEnv.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = runtimeEnv.PUBLIC_BING_SITE_VERIFICATION;
const gaMeasurementId = String(runtimeEnv.PUBLIC_GA4_MEASUREMENT_ID || '').trim();
const currentPath = Astro.url.pathname;

const defaultStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: companyName,
    url: siteOrigin.toString(),
    logo: new URL(logoSrc, siteOrigin).toString(),
    slogan: brandTagline
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brandName,
    url: siteOrigin.toString(),
    description: 'Parts, solutions, ideas, and freedom.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: brandName,
      url: siteOrigin.toString()
    }
  }
];

const jsonLd = structuredData
  ? [...defaultStructuredData, ...(Array.isArray(structuredData) ? structuredData : [structuredData])]
  : defaultStructuredData;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#030405" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href={logoSrc} />

    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={`${brandName} — ${brandTagline}`} />}

    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content={`${brandName} — ${brandTagline}`} />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    {gaMeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>}
    {gaMeasurementId && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        window.vnhTrack = function(name, params){ try { gtag('event', name, params || {}); } catch (_) {} };
        gtag('js', new Date());
        gtag('config', ${JSON.stringify(gaMeasurementId)}, { send_page_view: true });
      `}></script>
    )}
    {!gaMeasurementId && <script is:inline>window.vnhTrack = function(){};</script>}
    <title>{title}</title>
  </head>
  <body style={`--vnh-topo-image:url("${topoSrc}")`}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${brandName} home`}>
          <img class="brand-mark" src={logoSrc} alt="" />
          <div class="brand-lockup">
            <div class="brand-word">{brandName}</div>
            <div class="brand-tag">{brandTagline}</div>
          </div>
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="/shop" aria-current={currentPath.startsWith('/shop') ? 'page' : undefined}>{navShopLabel}</a>
          <a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>{navContactLabel}</a>
        </nav>
        <div class="header-actions" aria-label="Site actions">
          <button class="icon-button mobile-menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav" data-mobile-menu-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
          <a class="icon-button shop-search-icon" href="/shop" aria-label={browseShopAriaLabel}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></a>
          <a class="icon-button" href="/account" aria-label={accountAriaLabel} aria-current={currentPath === '/account' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.6-4 2.7-6 6.5-6s5.9 2 6.5 6"/></svg></a>
          <a class="icon-button cart-icon-button" href="/cart" aria-label={cartAriaLabel} data-cart-link aria-current={currentPath === '/cart' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2 10h10l2-7H7"/><circle cx="9" cy="19" r="1"/><circle cx="17" cy="19" r="1"/></svg>
            <span class="cart-count-badge" data-cart-badge hidden>0</span>
          </a>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-menu hidden>
        <div class="container mobile-nav-inner">
          <a href="/shop" aria-current={currentPath.startsWith('/shop') ? 'page' : undefined}>{navShopLabel}</a>
          <a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>{navContactLabel}</a>
          <a href="/account" aria-current={currentPath === '/account' ? 'page' : undefined}>Account</a>
        </div>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand"><img src={logoSrc} alt="" /><span>{brandName}</span></div>
        <div>© {new Date().getFullYear()} {footerText}</div>
        <div class="footer-links"><a href="/shop">{footerShopLabel}</a><a href="/contact">{footerContactLabel}</a></div>
      </div>
      <nav class="container footer-policies" aria-label="Store policies">
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">Refund Policy</a>
        <a href="/policies/shipping-policy">Shipping Policy</a>
        <a href="/policies/privacy-policy">Privacy Policy</a>
      </nav>
    </footer>

    <style is:global>
      .skip-link{position:fixed;left:12px;top:12px;z-index:9999;padding:10px 14px;background:#fff;color:#050607;font-weight:800;transform:translateY(-180%);transition:transform .15s}.skip-link:focus{transform:translateY(0)}
      :focus-visible{outline:2px solid #fff;outline-offset:3px}.main-nav a[aria-current="page"],.mobile-nav a[aria-current="page"]{color:#fff;text-decoration:underline;text-underline-offset:7px}.icon-button[aria-current="page"]{background:rgba(255,255,255,.08)}
      .mobile-menu-button{display:none;appearance:none;border:0;background:transparent;color:#fff;cursor:pointer;padding:0}.mobile-menu-button svg{pointer-events:none}.mobile-nav{display:none;border-top:1px solid rgba(255,255,255,.1);background:#050708;box-shadow:0 18px 30px rgba(0,0,0,.35)}.mobile-nav[hidden]{display:none!important}.mobile-nav-inner{display:grid;grid-template-columns:repeat(4,1fr);gap:0}.mobile-nav a{min-height:54px;display:flex;align-items:center;justify-content:center;border-right:1px solid rgba(255,255,255,.08);font-size:.82rem;letter-spacing:.08em;text-transform:uppercase}.mobile-nav a:last-child{border-right:0}.mobile-nav a:hover,.mobile-nav a:focus-visible{background:rgba(255,255,255,.06)}
      .cart-icon-button{position:relative}.cart-count-badge{position:absolute;right:-5px;top:-6px;display:grid;place-items:center;min-width:18px;height:18px;padding:0 4px;box-sizing:border-box;border-radius:999px;background:#fff;color:#080a0c;font:800 10px/1 Oxanium,sans-serif;border:1px solid #080a0c}.cart-count-badge[hidden]{display:none!important}
      .footer-policies{display:flex;justify-content:center;align-items:center;gap:10px 22px;flex-wrap:wrap;padding-top:18px;padding-bottom:22px;border-top:1px solid rgba(255,255,255,.09)}.footer-policies a{color:#8f979e;text-decoration:none;font-size:.72rem;letter-spacing:.05em}.footer-policies a:hover,.footer-policies a:focus-visible{color:#fff;text-decoration:underline;text-underline-offset:3px}
      @media(max-width:1050px){.mobile-menu-button{display:grid}.mobile-nav:not([hidden]){display:block}}
      @media(max-width:640px){.shop-search-icon{display:none}.mobile-nav-inner{grid-template-columns:1fr 1fr}.mobile-nav a{border-bottom:1px solid rgba(255,255,255,.08)}.footer-policies{justify-content:flex-start;gap:12px 18px}.footer-policies a{font-size:.74rem}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    </style>
    <script is:inline>
      (() => {
        const KEY = 'vnh:cart-count';
        const badge = document.querySelector('[data-cart-badge]');
        const cartLink = document.querySelector('[data-cart-link]');
        if (badge instanceof HTMLElement) {
          const update = (value) => {
            const count = Math.max(0, Number(value) || 0);
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.hidden = count < 1;
            if (cartLink instanceof HTMLAnchorElement) cartLink.setAttribute('aria-label', count ? `Cart, ${count} item${count === 1 ? '' : 's'}` : 'Cart');
          };
          try { update(localStorage.getItem(KEY)); } catch { update(0); }
          window.addEventListener('vnh-cart-updated', (event) => update(event?.detail?.totalQuantity ?? localStorage.getItem(KEY)));
          window.addEventListener('storage', (event) => { if (event.key === KEY) update(event.newValue); });
        }

        const menuButton = document.querySelector('[data-mobile-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');
        const setMenu = (open) => {
          if (!(menuButton instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
          mobileMenu.hidden = !open;
          menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
          menuButton.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        };
        if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
          menuButton.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
          mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
              setMenu(false);
              menuButton.focus();
            }
          });
          window.addEventListener('resize', () => { if (window.innerWidth > 1050) setMenu(false); });
        }

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-checkout]') : null;
          if (!target) return;
          let itemCount = 0;
          try { itemCount = Math.max(0, Number(localStorage.getItem(KEY)) || 0); } catch {}
          window.vnhTrack?.('begin_checkout', { items_count: itemCount });
        });
      })();
    </script>
  </body>
</html>