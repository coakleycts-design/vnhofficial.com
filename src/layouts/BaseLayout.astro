---
import '../styles/global.css';
import '../styles/accessibility.css';
import '../styles/theme-fix.css';
import topo00 from '../topo-complete/topo-00.txt?raw';
import topo01 from '../topo-complete/topo-01.txt?raw';
import topo02 from '../topo-complete/topo-02.txt?raw';
import topo03a from '../topo-complete/topo-03a.txt?raw';
import topo03b from '../topo-complete/topo-03b.txt?raw';
import topo04a from '../topo-complete/topo-04a.txt?raw';
import topo04b from '../topo-complete/topo-04b.txt?raw';
import topo05a from '../topo-complete/topo-05a.txt?raw';
import topo05b from '../topo-complete/topo-05b.txt?raw';
import topo06a from '../topo-complete/topo-06a.txt?raw';
import topo06b from '../topo-complete/topo-06b.txt?raw';
import topo07a from '../topo-complete/topo-07a.txt?raw';
import topo07b from '../topo-complete/topo-07b.txt?raw';

const { title = 'VNH | Real People. Real Purpose.', description = 'Parts, solutions, ideas, freedom, and community.' } = Astro.props;
const topoB64 = (
  topo00 + topo01 + topo02 + topo03a + topo03b + topo04a + topo04b +
  topo05a + topo05b + topo06a + topo06b + topo07a + topo07b
).replace(/\s+/g, '');

if (topoB64.length !== 75444) {
  throw new Error(`VNH topo background data is incomplete: ${topoB64.length}`);
}

const topoStyle = `--vnh-topo:url("data:image/webp;base64,${topoB64}")`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030405" />
    <link rel="icon" href="/vnh-logo-clean.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body style={topoStyle}>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="VNH home">
          <img class="brand-mark" src="/vnh-logo-clean.svg" alt="" />
          <div class="brand-lockup">
            <div class="brand-word">VNH</div>
            <div class="brand-tag">REAL PEOPLE. REAL PURPOSE.</div>
          </div>
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="/shop">Shop</a>
          <a href="/mission">Mission</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="header-actions" aria-label="Site actions">
          <a class="icon-button" href="/shop" aria-label="Search shop"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></a>
          <a class="icon-button" href="/shop" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.6-4 2.7-6 6.5-6s5.9 2 6.5 6"/></svg></a>
          <a class="icon-button" href="/shop" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2 10h10l2-7H7"/><circle cx="9" cy="19" r="1"/><circle cx="17" cy="19" r="1"/></svg></a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand"><img src="/vnh-logo-clean.svg" alt="" /><span>VNH</span></div>
        <div>© {new Date().getFullYear()} VNH. Real People. Real Purpose.</div>
        <div class="footer-links"><a href="/shop">Shop</a><a href="/mission">Mission</a><a href="/contact">Contact</a></div>
      </div>
    </footer>
  </body>
</html>