---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import '../styles/home-fix.css';
import '../styles/final-home.css';
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-logo-panel">
        <img class="hero-logo" src="/vnh-logo-clean.svg" alt="VNH gear emblem" />
      </div>

      <div class="hero-copy">
        <h1 class="display hero-words">Parts<br/>Solutions<br/>Ideas<br/>Freedom<br/>Community</h1>
        <div class="hero-tagline">Real People.<br/>Real Purpose.</div>
        <a class="button hero-button" href="/shop">Explore the Shop <span>→</span></a>
      </div>

      <div class="hero-aside" aria-hidden="true">
        <div class="hero-aside-title">Built<br/>for<br/>what's<br/>next</div>
        <div class="hero-aside-rule"></div>
        <div class="hero-aside-object"><span>PEOPLE<br/>PREPARED<br/>FOR A<br/>STRONGER<br/>TOMORROW</span></div>
      </div>
    </div>
  </section>

  <section class="value-strip" aria-label="VNH values">
    <div class="container value-grid">
      <div class="value"><div class="value-icon">⚙</div><strong>Quality Parts</strong><span>Built to last</span></div>
      <div class="value"><div class="value-icon">◯</div><strong>Real Solutions</strong><span>For everyday challenges</span></div>
      <div class="value"><div class="value-icon">◎</div><strong>A Growing Community</strong><span>People like you</span></div>
      <div class="value"><div class="value-icon">☆</div><strong>A Bigger Purpose</strong><span>More than a purchase</span></div>
    </div>
  </section>

  <section class="mission-band">
    <div class="container mission-inner">
      <div class="mission-person" aria-hidden="true"></div>
      <div class="mission-copy">
        <div class="eyebrow">Our Mission</div>
        <h2 class="display">Freedom Through Action</h2>
        <p>To support freedom, personal responsibility, and a community of individuals who refuse to back down.</p>
        <a class="button" href="/mission">Learn More <span>→</span></a>
      </div>
      <div class="mission-sideword" aria-hidden="true">Gear<br/>Knowledge<br/>People<br/>A Stronger<br/>Tomorrow</div>
    </div>
  </section>

  <section class="signup" id="keep-updated">
    <div class="container signup-inner">
      <div>
        <div class="eyebrow">Keep Updated</div>
        <h2 class="display">Stay in the Loop</h2>
        <p>Get the latest on new products, updates, exclusive releases, and more.</p>
      </div>
      <form class="signup-form" id="signup-form">
        <label class="sr-only" for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="Enter your email address" required />
        <button class="button primary" type="submit">Keep Me Updated <span>→</span></button>
        <div class="form-note" id="signup-status">No spam. Just what matters.</div>
      </form>
      <div class="signup-sideword" aria-hidden="true">Ideas Today<br/>A Stronger<br/>Tomorrow</div>
    </div>
  </section>

  <section class="collections">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Featured Collections</div><p>Quality gear for everyday readiness.</p></div>
        <a href="/shop" class="eyebrow shop-all">Shop All →</a>
      </div>
      <div class="collection-grid">
        <a class="collection-card" href="/shop"><div class="card-art fasteners"></div><div class="card-copy"><h3 class="display">Parts</h3><p>Reliable components for real use.</p><span>→</span></div></a>
        <a class="collection-card" href="/shop"><div class="card-art fieldgear"></div><div class="card-copy"><h3 class="display">Solutions</h3><p>Tools that work as hard as you do.</p><span>→</span></div></a>
        <a class="collection-card" href="/shop"><div class="card-art notebook"></div><div class="card-copy"><h3 class="display">Ideas</h3><p>Insights, resources, and perspectives.</p><span>→</span></div></a>
        <a class="collection-card" href="/mission"><div class="card-art people"></div><div class="card-copy"><h3 class="display">Community</h3><p>Stronger together.</p><span>→</span></div></a>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-flag" aria-hidden="true"></div>
    <div class="container closing-inner">
      <div>
        <h2 class="display">Real People. Real Purpose.</h2>
        <p>Parts &nbsp;|&nbsp; Solutions &nbsp;|&nbsp; Ideas &nbsp;|&nbsp; Freedom &nbsp;|&nbsp; Community</p>
      </div>
      <a class="button" href="#keep-updated">Be Part of It <span>→</span></a>
    </div>
  </section>

  <script>
    const form = document.querySelector('#signup-form');
    const status = document.querySelector('#signup-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = document.querySelector('#email');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      if (!email) return;
      if (status) status.textContent = 'Signing you up…';
      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error || 'Unable to subscribe');
        if (status) status.textContent = 'You’re on the list. Watch your inbox.';
        if (form instanceof HTMLFormElement) form.reset();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      }
    });
  </script>
</BaseLayout>