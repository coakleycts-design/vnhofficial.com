---
import BaseLayout from '../layouts/BaseLayout.astro';
import newCoin0 from '../assets/newcoin-fallback-00.txt?raw';
import newCoin1 from '../assets/newcoin-fallback-01.txt?raw';
import newCoin2 from '../assets/newcoin-fallback-02.txt?raw';
import { stickersFallbackSrc } from '../assets/product-stickers-inline';
import { getHomeMedia, getSiteMedia } from '../lib/sanity';
import '../styles/home.css';
import '../styles/home-fix.css';
import '../styles/final-home.css';

const [homeMedia, siteMedia] = await Promise.all([getHomeMedia(), getSiteMedia()]);
const newCoinBase64 = `${newCoin0}${newCoin1}${newCoin2}`.replace(/\s+/g, '');
if (newCoinBase64.length !== 16300 || !newCoinBase64.startsWith('/9j/') || !newCoinBase64.endsWith('/2Q==')) {
  throw new Error(`Invalid bundled NewCoin fallback (${newCoinBase64.length} chars)`);
}
const newCoinFallback = `data:image/jpeg;base64,${newCoinBase64}`;
const validSanityImage = (value?: string) => Boolean(value && /^https:\/\/cdn\.sanity\.io\/images\//.test(value));
const latestLeftSrc = validSanityImage(homeMedia.latestLeftUrl) ? homeMedia.latestLeftUrl! : newCoinFallback;
const latestRightSrc = validSanityImage(homeMedia.latestRightUrl) ? homeMedia.latestRightUrl! : stickersFallbackSrc;
const logoSrc = validSanityImage(siteMedia.logoUrl) ? siteMedia.logoUrl! : '/vnh-logo-clean.svg';
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-logo-panel">
        <img class="hero-logo" src={logoSrc} alt="VNH gear emblem" />
      </div>

      <div class="hero-copy">
        <h1 class="display hero-words">Parts<br/>Solutions<br/>Ideas<br/>Freedom</h1>
        <div class="hero-tagline">Real People.<br/>Real Purpose.</div>
        <a class="button hero-button" href="/shop">Explore the Shop <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="value-strip" aria-label="VNH values">
    <div class="container value-grid">
      <div class="value"><div class="value-icon">⚙</div><strong>Quality Parts</strong><span>Built to last</span></div>
      <div class="value"><div class="value-icon">◯</div><strong>Real Solutions</strong><span>For everyday challenges</span></div>
      <div class="value"><div class="value-icon">☆</div><strong>A Bigger Purpose</strong><span>More than a purchase</span></div>
    </div>
  </section>

  <section class="mission-band">
    <div class="container mission-inner">
      <div class="mission-person" aria-hidden="true"></div>
      <div class="mission-copy">
        <div class="eyebrow">Our Mission</div>
        <h2 class="display">Freedom Through Action</h2>
        <a class="button" href="/mission">Learn More <span>→</span></a>
      </div>
      <div class="mission-sideword" aria-hidden="true">Parts<br/>Solutions<br/>Ideas<br/>Freedom</div>
    </div>
  </section>

  <section class="signup" id="keep-updated">
    <div class="container signup-inner">
      <div>
        <div class="eyebrow">Keep Updated</div>
        <h2 class="display">Stay in the Loop</h2>
        <p>Get the latest on new products, updates, exclusive releases, and more.</p>
      </div>
      <form class="signup-form" id="signup-form">
        <label class="sr-only" for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="Enter your email address" required />
        <button class="button primary" type="submit">Keep Me Updated <span>→</span></button>
        <div class="form-note" id="signup-status">No spam. Just what matters.</div>
      </form>
      <div class="signup-sideword" aria-hidden="true">Ideas Today<br/>A Stronger<br/>Tomorrow</div>
    </div>
  </section>

  <section class="collections shop-feature">
    <div class="container">
      <div class="section-head shop-feature-head">
        <div>
          <div class="eyebrow">Shop</div>
          <h2 class="display">Latest from VNH</h2>
        </div>
      </div>

      <a class="product-showcase-link" href="/shop" aria-label="Shop all VNH products">
        <div class="product-showcase">
          <div class="product-photo product-photo-model">
            <img src={latestLeftSrc} alt="VNH 3D printed model" loading="eager" />
          </div>
          <div class="product-photo product-photo-stickers">
            <img src={latestRightSrc} alt="VNH sticker collection" loading="lazy" />
          </div>
        </div>
      </a>
    </div>
  </section>

  <script>
    const form = document.querySelector('#signup-form');
    const status = document.querySelector('#signup-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = document.querySelector('#email');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      if (!email) return;
      if (status) status.textContent = 'Signing you up…';
      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error || 'Unable to subscribe');
        if (status) status.textContent = 'You’re on the list. Watch your inbox.';
        if (form instanceof HTMLFormElement) form.reset();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      }
    });
  </script>
</BaseLayout>