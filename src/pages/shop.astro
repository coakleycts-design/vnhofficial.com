---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Shop | VNH" description="Shop VNH merchandise and products.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Shop</div>
      <h1 class="display">Built for Real Use</h1>
      <p>The storefront is being prepared for Shopify. Products will appear here once the catalog connection is configured.</p>
    </div>
  </section>
  <section class="container page-copy">
    <div class="collection-grid">
      <div class="collection-card"><h3 class="display">Stickers</h3><p>VNH branded designs and releases.</p></div>
      <div class="collection-card"><h3 class="display">Coins</h3><p>Collectible VNH challenge coins.</p></div>
      <div class="collection-card"><h3 class="display">Apparel</h3><p>Coming as the catalog expands.</p></div>
      <div class="collection-card"><h3 class="display">More</h3><p>New products and useful gear in development.</p></div>
    </div>
  </section>
</BaseLayout>
