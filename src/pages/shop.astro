---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Shop VNH | Products, Stickers, Collectibles & More"
  description="Shop VNH products, stickers, collectibles, apparel, and new releases built around practical ideas and real-world use."
>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Shop</div>
      <h1 class="display">Built for Real Use</h1>
      <p>The storefront is being prepared for Shopify. Products will appear here once the catalog connection is configured.</p>
    </div>
  </section>
  <section class="container page-copy">
    <div class="collection-grid">
      <div class="collection-card"><h2 class="display">Stickers</h2><p>VNH branded designs and releases.</p></div>
      <div class="collection-card"><h2 class="display">Coins</h2><p>Collectible VNH challenge coins.</p></div>
      <div class="collection-card"><h2 class="display">Apparel</h2><p>Coming as the catalog expands.</p></div>
      <div class="collection-card"><h2 class="display">More</h2><p>New products and useful items in development.</p></div>
    </div>
  </section>
</BaseLayout>
