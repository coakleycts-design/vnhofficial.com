---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getShopifyPolicy,
  isVnhPolicySlug,
  policyLabels,
  shopifyPolicyFallbackUrl,
  type ShopifyPolicy,
} from '../../lib/shopifyPolicies';

const runtimeEnv = ((Astro.locals as any)?.runtime?.env ?? import.meta.env) as Record<string, unknown>;
const buyerIp = Astro.request.headers.get('CF-Connecting-IP');
const requested = String(Astro.params.policy || '').trim();

if (!isVnhPolicySlug(requested)) {
  Astro.response.status = 404;
}

const slug = isVnhPolicySlug(requested) ? requested : null;
let policy: ShopifyPolicy | null = null;
let errorMessage = '';

if (slug) {
  try {
    policy = await getShopifyPolicy(runtimeEnv, slug, buyerIp);
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : 'Unable to load this policy.';
  }
}

if (slug && !policy && !errorMessage) Astro.response.status = 404;

const title = policy?.title || (slug ? policyLabels[slug] : 'Policy');
const seoTitle = `${title} | VNH Engineered Design`;
const seoDescription = `${title} for VNH Engineered Design.`;
const fallbackUrl = slug ? shopifyPolicyFallbackUrl(slug) : '/shop';
---
<BaseLayout title={seoTitle} description={seoDescription}>
  <main class="policy-page container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>{title}</span>
    </nav>

    {policy ? (
      <article class="policy-shell">
        <header class="policy-header">
          <div class="eyebrow">Policies</div>
          <h1 class="display">{policy.title}</h1>
        </header>
        <div class="policy-body" set:html={policy.body}></div>
      </article>
    ) : (
      <section class="policy-shell policy-error">
        <div class="eyebrow">Policies</div>
        <h1 class="display">{title}</h1>
        <p>{errorMessage || 'This policy is not currently available on the VNH site.'}</p>
        <a class="policy-button" href={fallbackUrl} target={slug ? '_blank' : undefined} rel={slug ? 'noopener noreferrer' : undefined}>
          {slug ? 'View policy on Shopify' : 'Return to shop'}
        </a>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .policy-page{padding-top:clamp(28px,4vw,54px);padding-bottom:clamp(78px,9vw,126px)}
  .breadcrumbs{display:flex;gap:9px;align-items:center;margin-bottom:clamp(25px,4vw,44px);font-size:.78rem;color:#9ea6ad}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover,.breadcrumbs a:focus-visible{color:#fff}
  .policy-shell{max-width:920px;margin:0 auto;padding:clamp(28px,5vw,58px);border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.025)}
  .policy-header{padding-bottom:28px;margin-bottom:30px;border-bottom:1px solid rgba(255,255,255,.12)}.policy-header h1,.policy-error h1{margin:.45rem 0 0;font-size:clamp(2.5rem,6vw,5rem);line-height:1}
  .policy-body{color:#c8cdd1;line-height:1.72;font-size:1rem;overflow-wrap:anywhere}
  .policy-body :global(h1),.policy-body :global(h2),.policy-body :global(h3),.policy-body :global(h4){color:#fff;font-family:Oxanium,sans-serif;line-height:1.15;margin:2rem 0 .75rem}.policy-body :global(h1){font-size:1.8rem}.policy-body :global(h2){font-size:1.5rem}.policy-body :global(h3){font-size:1.22rem}.policy-body :global(p){margin:0 0 1rem}.policy-body :global(ul),.policy-body :global(ol){padding-left:1.4rem;margin:0 0 1.2rem}.policy-body :global(li){margin:.4rem 0}.policy-body :global(a){color:#fff;text-underline-offset:3px}.policy-body :global(strong){color:#fff}.policy-body :global(table){width:100%;border-collapse:collapse;margin:1.25rem 0}.policy-body :global(th),.policy-body :global(td){padding:10px;border:1px solid rgba(255,255,255,.15);text-align:left;vertical-align:top}
  .policy-error p{color:#c8cdd1;line-height:1.7;margin:1.25rem 0 1.7rem}.policy-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border:1px solid #fff;background:#fff;color:#0b0d0f;text-decoration:none;font:800 .74rem/1 Oxanium,sans-serif;letter-spacing:.09em;text-transform:uppercase}.policy-button:hover,.policy-button:focus-visible{background:transparent;color:#fff}
  @media(max-width:600px){.policy-shell{padding:24px 18px}.policy-body{font-size:.95rem}}
</style>
