---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Your Cart | VNH Engineered Design"
  description="Review your VNH cart, update quantities, and continue to secure Shopify checkout when ready."
>
  <main class="cart-page container" data-cart-page>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/shop">Shop</a><span aria-hidden="true">/</span><span>Cart</span></nav>

    <header class="cart-header">
      <div>
        <div class="eyebrow">VNH Store</div>
        <h1 class="display">Your Cart</h1>
      </div>
      <a class="continue-link" href="/shop">Continue shopping</a>
    </header>

    <div class="cart-message" data-cart-message aria-live="polite">Loading your cart…</div>

    <section class="cart-empty" data-cart-empty hidden>
      <h2 class="display">Your cart is empty.</h2>
      <p>Browse the VNH shop and add products here before checkout.</p>
      <a class="primary-button" href="/shop">Shop VNH</a>
    </section>

    <section class="cart-layout" data-cart-content hidden>
      <div class="cart-lines" data-cart-lines></div>
      <aside class="cart-summary">
        <div class="summary-row"><span>Items</span><strong data-cart-count>0</strong></div>
        <div class="summary-row total"><span>Subtotal</span><strong data-cart-subtotal>—</strong></div>
        <p>Shipping, taxes, discounts, and final totals are calculated securely during checkout.</p>
        <button class="checkout-button" type="button" data-checkout>Checkout</button>
        <div class="checkout-error" data-checkout-error aria-live="polite"></div>
        <div class="shopify-note">Checkout is securely completed by Shopify.</div>
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .cart-page{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(72px,9vw,120px)}
  .breadcrumbs{display:flex;gap:9px;align-items:center;margin-bottom:clamp(24px,4vw,42px);font-size:.78rem;color:#9ea6ad}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover,.breadcrumbs a:focus-visible{color:#fff}
  .cart-header{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:34px}.cart-header h1{margin:.35rem 0 0;font-size:clamp(2.7rem,6vw,5.6rem)}.continue-link{color:#c5cbd0;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:3px}.continue-link:hover,.continue-link:focus-visible{color:#fff;border-color:#fff}
  .cart-message{min-height:24px;color:#aeb5bc}.cart-message.is-error{color:#e5a998}
  [data-cart-empty][hidden],[data-cart-content][hidden]{display:none!important}
  .cart-empty{padding:clamp(34px,6vw,68px);border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.03)}.cart-empty h2{margin:0 0 14px}.cart-empty p{color:#c6cbd0;margin:0 0 24px}.primary-button,.checkout-button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 22px;border:1px solid #fff;background:#fff;color:#0b0d0f;text-decoration:none;font:800 .76rem/1 Oxanium,sans-serif;letter-spacing:.1em;text-transform:uppercase}.primary-button:hover,.primary-button:focus-visible,.checkout-button:hover,.checkout-button:focus-visible{background:transparent;color:#fff}.checkout-button{width:100%;cursor:pointer}.checkout-button:disabled{opacity:.55;cursor:wait}
  .cart-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,380px);gap:clamp(28px,5vw,64px);align-items:start}.cart-lines{display:grid;gap:14px}.cart-line{display:grid;grid-template-columns:150px minmax(0,1fr) auto;gap:20px;padding:14px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.025)}.cart-line-image{aspect-ratio:1/1;background:#0c0d0f;display:grid;place-items:center;overflow:hidden}.cart-line-image img{width:100%;height:100%;object-fit:contain;display:block}.cart-line-placeholder{font:700 1.5rem/1 Oxanium,sans-serif;letter-spacing:.12em;color:rgba(255,255,255,.2)}.cart-line-body{min-width:0;padding:6px 0}.cart-line-title{display:inline-block;color:#fff;text-decoration:none;font:700 clamp(1rem,2vw,1.25rem)/1.2 Oxanium,sans-serif}.cart-line-title:hover,.cart-line-title:focus-visible{text-decoration:underline}.cart-line-option{margin-top:8px;color:#9da5ac;font-size:.82rem}.cart-line-unit{margin-top:12px;color:#d7dce0;font-size:.9rem}.cart-line-controls{display:flex;align-items:end;gap:10px;margin-top:18px;flex-wrap:wrap}.cart-line-controls label{display:grid;gap:7px;font:700 .66rem/1 Oxanium,sans-serif;letter-spacing:.1em;text-transform:uppercase}.cart-line-controls input{width:78px;min-height:42px;box-sizing:border-box;padding:8px 10px;background:#111417;color:#fff;border:1px solid rgba(255,255,255,.25);font:inherit;font-size:16px}.remove-button{min-height:42px;padding:8px 10px;background:transparent;color:#b9c0c6;border:0;border-bottom:1px solid rgba(255,255,255,.28);cursor:pointer;font:700 .7rem/1 Oxanium,sans-serif;text-transform:uppercase;letter-spacing:.08em}.remove-button:hover,.remove-button:focus-visible{color:#fff;border-color:#fff}.cart-line-total{padding:8px 4px;font-weight:800;white-space:nowrap}.cart-line.is-busy{opacity:.58;pointer-events:none}
  .cart-summary{position:sticky;top:110px;padding:26px;border:1px solid rgba(255,255,255,.14);background:#0b0d0f}.summary-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:11px 0;color:#bec5ca}.summary-row.total{margin-top:8px;padding-top:20px;border-top:1px solid rgba(255,255,255,.14);font-size:1.1rem;color:#fff}.summary-row.total strong{font-size:1.35rem}.cart-summary p{color:#8f979e;font-size:.78rem;line-height:1.55;margin:14px 0 22px}.shopify-note{margin-top:12px;text-align:center;color:#707980;font-size:.7rem}.checkout-error{min-height:20px;margin-top:10px;color:#e5a998;font-size:.78rem;line-height:1.4}
  @media(max-width:900px){.cart-layout{grid-template-columns:1fr}.cart-summary{position:static}.cart-line{grid-template-columns:120px minmax(0,1fr)}.cart-line-total{grid-column:2}}
  @media(max-width:600px){.cart-header{align-items:flex-start;flex-direction:column}.cart-line{grid-template-columns:92px minmax(0,1fr);gap:14px}.cart-line-controls{align-items:stretch;flex-direction:column}.cart-line-controls input{width:100%}.remove-button{text-align:left}.cart-line-total{grid-column:2}.cart-summary{padding:22px}}
</style>

<script is:inline>
(() => {
  const CART_ID_KEY = 'vnh:shopify-cart-id';
  const CART_COUNT_KEY = 'vnh:cart-count';
  const root = document.querySelector('[data-cart-page]');
  if (!root) return;

  const message = root.querySelector('[data-cart-message]');
  const empty = root.querySelector('[data-cart-empty]');
  const content = root.querySelector('[data-cart-content]');
  const linesRoot = root.querySelector('[data-cart-lines]');
  const countNode = root.querySelector('[data-cart-count]');
  const subtotalNode = root.querySelector('[data-cart-subtotal]');
  const checkoutButton = root.querySelector('[data-checkout]');
  const checkoutError = root.querySelector('[data-checkout-error]');
  let currentCart = null;

  const money = (value) => {
    if (!value) return '—';
    try {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: value.currencyCode }).format(Number(value.amount));
    } catch {
      return `${value.amount} ${value.currencyCode || ''}`.trim();
    }
  };

  const setMessage = (text, isError = false) => {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = text;
    message.classList.toggle('is-error', isError);
  };

  const publishCart = (cart) => {
    const quantity = Number(cart?.totalQuantity || 0);
    localStorage.setItem(CART_COUNT_KEY, String(quantity));
    if (cart?.id) localStorage.setItem(CART_ID_KEY, cart.id);
    window.dispatchEvent(new CustomEvent('vnh-cart-updated', { detail: cart }));
  };

  const showEmpty = () => {
    currentCart = null;
    localStorage.removeItem(CART_ID_KEY);
    localStorage.setItem(CART_COUNT_KEY, '0');

    if (linesRoot instanceof HTMLElement) linesRoot.replaceChildren();
    if (countNode) countNode.textContent = '0';
    if (subtotalNode) subtotalNode.textContent = '—';
    if (checkoutError) checkoutError.textContent = '';
    if (checkoutButton instanceof HTMLButtonElement) {
      checkoutButton.disabled = false;
      checkoutButton.textContent = 'Checkout';
    }

    if (content instanceof HTMLElement) content.hidden = true;
    if (empty instanceof HTMLElement) empty.hidden = false;
    setMessage('');
    window.dispatchEvent(new CustomEvent('vnh-cart-updated', { detail: { totalQuantity: 0 } }));
  };

  const apiPost = async (body) => {
    const response = await fetch('/api/shopify/cart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const payload = await response.json();
    if (!response.ok || !payload?.ok || !payload?.cart) throw new Error(payload?.error || 'Unable to update cart.');
    return payload.cart;
  };

  const createText = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    node.textContent = text;
    return node;
  };

  const renderLine = (line) => {
    const variant = line.merchandise || {};
    const product = variant.product || {};
    const article = document.createElement('article');
    article.className = 'cart-line';
    article.dataset.lineId = line.id;

    const imageLink = document.createElement('a');
    imageLink.className = 'cart-line-image';
    imageLink.href = `/shop/${encodeURIComponent(product.handle || '')}`;
    const image = variant.image || product.featuredImage;
    if (image?.url) {
      const img = document.createElement('img');
      img.src = image.url;
      img.alt = image.altText || product.title || 'VNH product';
      img.loading = 'lazy';
      imageLink.append(img);
    } else {
      imageLink.append(createText('span', 'cart-line-placeholder', 'VNH'));
    }

    const body = document.createElement('div');
    body.className = 'cart-line-body';
    const title = document.createElement('a');
    title.className = 'cart-line-title';
    title.href = `/shop/${encodeURIComponent(product.handle || '')}`;
    title.textContent = product.title || 'VNH Product';
    body.append(title);

    const options = Array.isArray(variant.selectedOptions)
      ? variant.selectedOptions.filter((item) => item?.value && item.value !== 'Default Title').map((item) => `${item.name}: ${item.value}`).join(' · ')
      : '';
    if (options) body.append(createText('div', 'cart-line-option', options));
    body.append(createText('div', 'cart-line-unit', `${money(variant.price)} each`));

    const controls = document.createElement('div');
    controls.className = 'cart-line-controls';
    const label = document.createElement('label');
    label.append(createText('span', '', 'Quantity'));
    const input = document.createElement('input');
    input.type = 'number';
    input.min = '1';
    input.max = '99';
    input.step = '1';
    input.value = String(line.quantity || 1);
    input.inputMode = 'numeric';
    input.setAttribute('aria-label', `Quantity for ${product.title || 'product'}`);
    label.append(input);
    controls.append(label);

    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'remove-button';
    remove.textContent = 'Remove';
    controls.append(remove);
    body.append(controls);

    const total = createText('div', 'cart-line-total', money(line.cost?.totalAmount));
    article.append(imageLink, body, total);

    input.addEventListener('change', async () => {
      const quantity = Math.max(1, Math.min(99, Number(input.value) || 1));
      input.value = String(quantity);
      const cartId = currentCart?.id || localStorage.getItem(CART_ID_KEY) || '';
      const lineId = String(line?.id || '');
      if (!cartId || !lineId) {
        showEmpty();
        return;
      }
      article.classList.add('is-busy');
      setMessage('Updating cart…');
      try {
        const cart = await apiPost({ action: 'update', cartId, lineId, quantity });
        renderCart(cart);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Unable to update quantity.', true);
        article.classList.remove('is-busy');
      }
    });

    remove.addEventListener('click', async () => {
      const cartId = currentCart?.id || localStorage.getItem(CART_ID_KEY) || '';
      const lineId = String(line?.id || '');
      if (!cartId || !lineId) {
        showEmpty();
        return;
      }

      remove.disabled = true;
      article.classList.add('is-busy');
      setMessage('Removing item…');
      try {
        const cart = await apiPost({ action: 'remove', cartId, lineId });
        const remainingLines = Array.isArray(cart?.lines?.nodes) ? cart.lines.nodes : [];
        if (!remainingLines.length || Number(cart?.totalQuantity || 0) === 0) {
          showEmpty();
          return;
        }
        renderCart(cart);
      } catch (error) {
        setMessage(error instanceof Error ? error.message : 'Unable to remove item.', true);
        article.classList.remove('is-busy');
        remove.disabled = false;
      }
    });

    return article;
  };

  const renderCart = (cart) => {
    const lines = Array.isArray(cart?.lines?.nodes) ? cart.lines.nodes : [];
    if (!cart?.id || !lines.length || Number(cart?.totalQuantity || 0) === 0) {
      showEmpty();
      return;
    }

    currentCart = cart;
    publishCart(cart);
    if (empty instanceof HTMLElement) empty.hidden = true;
    if (content instanceof HTMLElement) content.hidden = false;
    if (linesRoot instanceof HTMLElement) linesRoot.replaceChildren(...lines.map(renderLine));
    if (countNode) countNode.textContent = String(cart.totalQuantity || 0);
    if (subtotalNode) subtotalNode.textContent = money(cart.cost?.subtotalAmount);
    setMessage('');
  };

  const loadCart = async () => {
    const cartId = localStorage.getItem(CART_ID_KEY) || '';
    if (!cartId) {
      showEmpty();
      return;
    }
    try {
      const response = await fetch(`/api/shopify/cart?cartId=${encodeURIComponent(cartId)}`, { cache: 'no-store' });
      const payload = await response.json();
      if (!response.ok || !payload?.ok || !payload?.cart) {
        showEmpty();
        return;
      }
      renderCart(payload.cart);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : 'Unable to load your cart.', true);
    }
  };

  if (checkoutButton instanceof HTMLButtonElement) {
    checkoutButton.addEventListener('click', async () => {
      const cartId = currentCart?.id || localStorage.getItem(CART_ID_KEY) || '';
      if (!cartId) {
        showEmpty();
        return;
      }
      checkoutButton.disabled = true;
      checkoutButton.textContent = 'Opening checkout…';
      if (checkoutError) checkoutError.textContent = '';
      try {
        const response = await fetch(`/api/shopify/cart?cartId=${encodeURIComponent(cartId)}`, { cache: 'no-store' });
        const payload = await response.json();
        if (!response.ok || !payload?.ok || !payload?.cart?.checkoutUrl) throw new Error(payload?.error || 'Checkout is unavailable right now.');
        window.location.href = payload.cart.checkoutUrl;
      } catch (error) {
        if (checkoutError) checkoutError.textContent = error instanceof Error ? error.message : 'Checkout is unavailable right now.';
        checkoutButton.disabled = false;
        checkoutButton.textContent = 'Checkout';
      }
    });
  }

  loadCart();
})();
</script>
