---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | VNH" description="Contact VNH.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Contact</div>
      <h1 class="display">Get in Touch</h1>
      <p>Questions, ideas, order support, or something we should know? Send us a message.</p>
    </div>
  </section>
  <section class="container page-copy">
    <form class="contact-form" id="contact-form">
      <input name="name" type="text" placeholder="Name" required />
      <input name="email" type="email" placeholder="Email address" required />
      <input name="orderNumber" type="text" placeholder="Order number (optional)" />
      <select name="subject" required>
        <option value="">Select a topic</option>
        <option>General question</option>
        <option>Order support</option>
        <option>Product question</option>
        <option>Partnership or media</option>
      </select>
      <textarea name="message" placeholder="Message" required></textarea>
      <button class="button primary" type="submit">Send Message →</button>
      <div class="form-note" id="contact-status"></div>
    </form>
  </section>
  <script>
    const form = document.querySelector('#contact-form');
    const status = document.querySelector('#contact-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = Object.fromEntries(new FormData(form).entries());
      status.textContent = 'Sending…';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error || 'Unable to send message');
        status.textContent = 'Message sent. We’ll be in touch.';
        form.reset();
      } catch (error) {
        status.textContent = error?.message || 'Something went wrong. Please try again.';
      }
    });
  </script>
</BaseLayout>
