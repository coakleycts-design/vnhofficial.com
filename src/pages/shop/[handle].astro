---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getShopifyProduct, type ShopifyMoney, type ShopifyProductDetail } from '../../lib/shopify';

const runtimeEnv = ((Astro.locals as any)?.runtime?.env ?? import.meta.env) as Record<string, unknown>;
const buyerIp = Astro.request.headers.get('CF-Connecting-IP');
const handle = String(Astro.params.handle || '').trim();

if (!handle) {
  return Astro.redirect('/shop');
}

let product: ShopifyProductDetail | null = null;
let errorMessage = '';

try {
  product = await getShopifyProduct(runtimeEnv, handle, buyerIp);
} catch (error) {
  errorMessage = error instanceof Error ? error.message : 'Unable to load this product.';
}

const money = (value?: ShopifyMoney | null) => {
  if (!value) return '';
  try {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: value.currencyCode }).format(Number(value.amount));
  } catch {
    return `${value.amount} ${value.currencyCode}`;
  }
};

const selectedVariant = product?.variants.nodes.find((variant) => variant.availableForSale) || product?.variants.nodes[0] || null;
const selectedCompare = selectedVariant?.compareAtPrice && Number(selectedVariant.compareAtPrice.amount) > Number(selectedVariant.price.amount)
  ? money(selectedVariant.compareAtPrice)
  : '';
const seoTitle = product?.seo?.title?.trim() || (product ? `${product.title} | VNH Engineered Design` : 'Product | VNH Engineered Design');
const seoDescription = product?.seo?.description?.trim() || product?.description?.trim() || 'Shop VNH Engineered Design products.';
const images = product?.images?.nodes?.length ? product.images.nodes : product?.featuredImage ? [product.featuredImage] : [];
---
<BaseLayout title={seoTitle} description={seoDescription}>
  {product ? (
    <main class="product-page container" data-product-page>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/shop">Shop</a><span aria-hidden="true">/</span><span>{product.title}</span>
      </nav>

      <section class="product-layout">
        <div class="gallery" data-gallery>
          <div class="gallery-main">
            {images[0]?.url ? (
              <img
                data-main-image
                src={images[0].url}
                alt={images[0].altText || product.title}
                width={images[0].width || 1200}
                height={images[0].height || 1200}
              />
            ) : (
              <div class="gallery-placeholder">VNH</div>
            )}
          </div>
          {images.length > 1 && (
            <div class="gallery-thumbs" aria-label="Product images">
              {images.map((image, index) => (
                <button
                  type="button"
                  class:list={['gallery-thumb', index === 0 && 'is-active']}
                  data-thumb
                  data-image-url={image.url}
                  data-image-alt={image.altText || product.title}
                  aria-label={`Show image ${index + 1} of ${images.length}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <img src={image.url} alt="" loading="lazy" width={image.width || 180} height={image.height || 180} />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="product-info">
          <div class="eyebrow">{product.productType || 'VNH Product'}</div>
          <h1 class="display">{product.title}</h1>
          <div class:list={['availability', selectedVariant?.availableForSale ? 'available' : 'unavailable']} data-availability>
            {selectedVariant?.availableForSale ? 'Available' : 'Currently unavailable'}
          </div>

          {selectedVariant && (
            <div class="price-row" aria-live="polite">
              <span class="compare-price" data-compare-price hidden={!selectedCompare}>{selectedCompare}</span>
              <strong data-current-price>{money(selectedVariant.price)}</strong>
            </div>
          )}

          {product.variants.nodes.length > 1 && (
            <div class="variant-picker">
              <label for="variant-select">Option</label>
              <select id="variant-select" data-variant-select>
                {product.variants.nodes.map((variant) => (
                  <option
                    value={variant.id}
                    data-price={money(variant.price)}
                    data-compare={variant.compareAtPrice && Number(variant.compareAtPrice.amount) > Number(variant.price.amount) ? money(variant.compareAtPrice) : ''}
                    data-available={variant.availableForSale ? 'true' : 'false'}
                    selected={variant.id === selectedVariant?.id}
                  >
                    {variant.title}{!variant.availableForSale ? ' — Sold out' : ''}
                  </option>
                ))}
              </select>
            </div>
          )}

          <div class="description" set:html={product.descriptionHtml || product.description}></div>

          <div class="buy-box">
            <label class="quantity-field">
              <span>Quantity</span>
              <input type="number" min="1" max="99" step="1" value="1" inputmode="numeric" data-quantity />
            </label>
            <button
              class:list={['purchase-button', !selectedVariant?.availableForSale && 'is-disabled']}
              type="button"
              data-add-to-cart
              data-variant-id={selectedVariant?.id || ''}
              disabled={!selectedVariant?.availableForSale}
            >
              {selectedVariant?.availableForSale ? 'Add to cart' : 'Currently unavailable'}
            </button>
          </div>

          <div class="cart-feedback" data-cart-feedback aria-live="polite"></div>
          <div class="purchase-actions">
            <a class="back-link" href="/shop">Continue shopping</a>
            <a class="back-link" href="/cart">View cart</a>
          </div>
          <p class="checkout-note">Add products to your VNH cart here. Shopify only takes over when you choose Checkout.</p>
        </div>
      </section>
    </main>
  ) : (
    <main class="product-page container">
      <section class="product-error">
        <div class="eyebrow">VNH Store</div>
        <h1 class="display">Product unavailable</h1>
        <p>{errorMessage || 'We could not find that product.'}</p>
        <div class="purchase-actions">
          <a class="purchase-button" href="/shop">Return to shop</a>
        </div>
      </section>
    </main>
  )}
</BaseLayout>

<style>
  .product-page{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(70px,9vw,120px)}
  .breadcrumbs{display:flex;gap:9px;align-items:center;margin-bottom:clamp(24px,4vw,42px);font-size:.78rem;color:#9ea6ad}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover,.breadcrumbs a:focus-visible{color:#fff}
  .product-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr);gap:clamp(34px,6vw,82px);align-items:start}
  .gallery{min-width:0}.gallery-main{aspect-ratio:1/1;background:#0c0d0f;border:1px solid rgba(255,255,255,.11);display:grid;place-items:center;overflow:hidden}.gallery-main img{display:block;width:100%;height:100%;object-fit:contain}.gallery-placeholder{font:700 clamp(3rem,8vw,8rem)/1 Oxanium,sans-serif;letter-spacing:.16em;color:rgba(255,255,255,.16)}
  .gallery-thumbs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:12px}.gallery-thumb{appearance:none;padding:0;aspect-ratio:1/1;border:1px solid rgba(255,255,255,.14);background:#0c0d0f;cursor:pointer;overflow:hidden}.gallery-thumb img{width:100%;height:100%;object-fit:cover;display:block}.gallery-thumb.is-active{border-color:#fff}.gallery-thumb:focus-visible{outline:2px solid #fff;outline-offset:2px}
  .product-info{padding-top:8px}.product-info h1{font-size:clamp(2.5rem,5vw,5.3rem);line-height:.95;margin:.4rem 0 14px}.availability{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:#adb5bc}.availability.available{color:#d9e2da}.availability.unavailable{color:#d5b1a1}
  .price-row{display:flex;align-items:baseline;gap:12px;margin:24px 0}.price-row strong{font-size:clamp(1.55rem,3vw,2.25rem)}.compare-price{text-decoration:line-through;color:#8f979f;font-size:1rem}
  .variant-picker{display:grid;gap:8px;margin:0 0 24px}.variant-picker label,.quantity-field span{font:700 .72rem/1 Oxanium,sans-serif;letter-spacing:.1em;text-transform:uppercase}.variant-picker select,.quantity-field input{min-height:48px;background:#111417;color:#fff;border:1px solid rgba(255,255,255,.25);font:inherit;font-size:16px}.variant-picker select{width:100%;padding:10px 42px 10px 12px}.quantity-field{display:grid;gap:8px}.quantity-field input{width:86px;padding:10px 12px;box-sizing:border-box}
  .description{color:#c7ccd0;line-height:1.75;font-size:1rem}.description :global(p){margin:0 0 1rem}.description :global(ul),.description :global(ol){padding-left:1.25rem}.description :global(h2),.description :global(h3){color:#fff;font-family:Oxanium,sans-serif;margin:1.5rem 0 .65rem}
  .buy-box{display:flex;align-items:end;gap:14px;flex-wrap:wrap;margin-top:30px}.purchase-button{appearance:none;display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 26px;background:#fff;color:#0b0d0f;text-decoration:none;font:800 .76rem/1 Oxanium,sans-serif;letter-spacing:.1em;text-transform:uppercase;border:1px solid #fff;cursor:pointer}.purchase-button:hover,.purchase-button:focus-visible{background:transparent;color:#fff}.purchase-button.is-disabled,.purchase-button:disabled{pointer-events:none;opacity:.45}.purchase-button.is-loading{opacity:.7;cursor:wait}.purchase-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:18px}.back-link{color:#c5cbd0;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:3px}.back-link:hover,.back-link:focus-visible{color:#fff;border-color:#fff}.checkout-note{margin-top:16px;color:#879099;font-size:.78rem;line-height:1.5}.cart-feedback{min-height:24px;margin-top:12px;font-size:.82rem;color:#d9e2da}.cart-feedback.is-error{color:#e5a998}
  .product-error{max-width:760px;padding:clamp(42px,7vw,82px) 0}.product-error h1{margin:.5rem 0 18px}.product-error p{color:#c7ccd0;line-height:1.7}
  @media(max-width:900px){.product-layout{grid-template-columns:1fr}.product-info{padding-top:0}.gallery-thumbs{grid-template-columns:repeat(5,minmax(0,1fr))}}
  @media(max-width:560px){.product-page{padding-top:20px}.gallery-thumbs{grid-template-columns:repeat(4,minmax(0,1fr))}.buy-box{align-items:stretch;flex-direction:column}.quantity-field input,.purchase-button{width:100%}.purchase-actions{align-items:flex-start;flex-direction:column}.product-info h1{font-size:clamp(2.3rem,12vw,3.5rem)}}
</style>

<script is:inline>
(() => {
  const CART_ID_KEY = 'vnh:shopify-cart-id';
  const CART_COUNT_KEY = 'vnh:cart-count';
  const root = document.querySelector('[data-product-page]');
  if (!root) return;

  const mainImage = root.querySelector('[data-main-image]');
  root.querySelectorAll('[data-thumb]').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (!(mainImage instanceof HTMLImageElement) || !(thumb instanceof HTMLElement)) return;
      const url = thumb.dataset.imageUrl;
      if (!url) return;
      mainImage.src = url;
      mainImage.alt = thumb.dataset.imageAlt || '';
      root.querySelectorAll('[data-thumb]').forEach((item) => {
        item.classList.toggle('is-active', item === thumb);
        item.setAttribute('aria-pressed', item === thumb ? 'true' : 'false');
      });
    });
  });

  const select = root.querySelector('[data-variant-select]');
  const price = root.querySelector('[data-current-price]');
  const compare = root.querySelector('[data-compare-price]');
  const availability = root.querySelector('[data-availability]');
  const addButton = root.querySelector('[data-add-to-cart]');
  const quantityInput = root.querySelector('[data-quantity]');
  const feedback = root.querySelector('[data-cart-feedback]');

  const setFeedback = (message, isError = false) => {
    if (!(feedback instanceof HTMLElement)) return;
    feedback.textContent = message;
    feedback.classList.toggle('is-error', isError);
  };

  const applyVariant = () => {
    if (!(addButton instanceof HTMLButtonElement)) return;
    const option = select instanceof HTMLSelectElement ? select.selectedOptions[0] : null;
    if (option) {
      if (price) price.textContent = option.dataset.price || '';
      if (compare) {
        compare.textContent = option.dataset.compare || '';
        compare.toggleAttribute('hidden', !option.dataset.compare);
      }
      const available = option.dataset.available === 'true';
      addButton.dataset.variantId = option.value;
      addButton.disabled = !available;
      addButton.classList.toggle('is-disabled', !available);
      addButton.textContent = available ? 'Add to cart' : 'Currently unavailable';
      if (availability) {
        availability.textContent = available ? 'Available' : 'Currently unavailable';
        availability.classList.toggle('available', available);
        availability.classList.toggle('unavailable', !available);
      }
      setFeedback('');
    }
  };

  if (select instanceof HTMLSelectElement) {
    select.addEventListener('change', applyVariant);
    applyVariant();
  }

  if (addButton instanceof HTMLButtonElement) {
    addButton.addEventListener('click', async () => {
      const merchandiseId = addButton.dataset.variantId || '';
      const quantity = quantityInput instanceof HTMLInputElement ? Math.max(1, Math.min(99, Number(quantityInput.value) || 1)) : 1;
      if (!merchandiseId) return;

      addButton.disabled = true;
      addButton.classList.add('is-loading');
      addButton.textContent = 'Adding…';
      setFeedback('');

      try {
        const response = await fetch('/api/shopify/cart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'add',
            cartId: localStorage.getItem(CART_ID_KEY) || '',
            merchandiseId,
            quantity,
          }),
        });
        const payload = await response.json();
        if (!response.ok || !payload?.ok || !payload?.cart) throw new Error(payload?.error || 'Unable to add this item.');

        localStorage.setItem(CART_ID_KEY, payload.cart.id);
        localStorage.setItem(CART_COUNT_KEY, String(payload.cart.totalQuantity || 0));
        window.dispatchEvent(new CustomEvent('vnh-cart-updated', { detail: payload.cart }));
        addButton.textContent = 'Added to cart ✓';
        setFeedback(`${quantity} item${quantity === 1 ? '' : 's'} added. Your cart stays on VNH until checkout.`);
        window.setTimeout(() => {
          if (!addButton.disabled) addButton.textContent = 'Add to cart';
        }, 1800);
      } catch (error) {
        setFeedback(error instanceof Error ? error.message : 'Unable to add this item.', true);
        addButton.textContent = 'Try again';
      } finally {
        addButton.classList.remove('is-loading');
        const option = select instanceof HTMLSelectElement ? select.selectedOptions[0] : null;
        const available = option ? option.dataset.available === 'true' : true;
        addButton.disabled = !available;
        addButton.classList.toggle('is-disabled', !available);
      }
    });
  }
})();
</script>
