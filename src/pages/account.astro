---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  customerAccountCookies,
  getCustomerDashboard,
  hostedCustomerAccountUrl,
  isCustomerAccountConfigured,
  refreshCustomerToken,
  type CustomerDashboard,
  type CustomerOrderMoney,
  type CustomerTokenResponse,
} from '../lib/customerAccount';

const runtimeEnv = ((Astro.locals as any)?.runtime?.env ?? import.meta.env) as Record<string, unknown>;
const configured = isCustomerAccountConfigured(runtimeEnv);
const accessToken = Astro.cookies.get(customerAccountCookies.access)?.value || '';
const refreshToken = Astro.cookies.get(customerAccountCookies.refresh)?.value || '';
let customer: CustomerDashboard | null = null;
let accountError = '';

const setTokenCookies = (token: CustomerTokenResponse) => {
  const accessMaxAge = Math.max(300, Number(token.expires_in || 3600) - 60);
  Astro.cookies.set(customerAccountCookies.access, token.access_token, {
    path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: accessMaxAge,
  });
  if (token.refresh_token) {
    Astro.cookies.set(customerAccountCookies.refresh, token.refresh_token, {
      path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 30,
    });
  }
  if (token.id_token) {
    Astro.cookies.set(customerAccountCookies.idToken, token.id_token, {
      path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24,
    });
  }
};

const clearAccountCookies = () => {
  const options = { path: '/' };
  Astro.cookies.delete(customerAccountCookies.access, options);
  Astro.cookies.delete(customerAccountCookies.refresh, options);
  Astro.cookies.delete(customerAccountCookies.idToken, options);
};

if (configured && accessToken) {
  try {
    customer = await getCustomerDashboard(accessToken);
  } catch (error) {
    accountError = error instanceof Error ? error.message : 'Unable to load your account right now.';
  }
}

if (configured && !customer && refreshToken && !accountError) {
  try {
    const refreshed = await refreshCustomerToken(runtimeEnv, refreshToken);
    setTokenCookies(refreshed);
    customer = await getCustomerDashboard(refreshed.access_token);
    if (!customer) {
      clearAccountCookies();
      accountError = 'Your secure account session expired. Please sign in again.';
    }
  } catch {
    clearAccountCookies();
    accountError = 'Your secure account session expired. Please sign in again.';
  }
}

const money = (value?: CustomerOrderMoney | null) => {
  if (!value) return '';
  try {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: value.currencyCode }).format(Number(value.amount));
  } catch {
    return `${value.amount} ${value.currencyCode}`;
  }
};

const date = (value: string) => {
  try { return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(value)); }
  catch { return value; }
};

const friendlyStatus = (value?: string | null) => String(value || '').toLowerCase().replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const loginFailed = Astro.url.searchParams.get('login') === 'failed';
---
<BaseLayout
  title="Your Account | VNH Engineered Design"
  description="Sign in to your VNH customer account and review your order history."
  noindex={true}
>
  <main class="account-page container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Account</span></nav>

    {customer ? (
      <>
        <header class="account-header">
          <div>
            <div class="eyebrow">VNH Account</div>
            <h1 class="display">Welcome{customer.firstName ? `, ${customer.firstName}` : ''}</h1>
            {customer.emailAddress?.emailAddress && <p>{customer.emailAddress.emailAddress}</p>}
          </div>
          <div class="account-actions">
            <a class="secondary-button" href={hostedCustomerAccountUrl} target="_blank" rel="noopener noreferrer">Profile & addresses</a>
            <a class="secondary-button" href="/api/shopify/account/logout">Sign out</a>
          </div>
        </header>

        <section class="orders-section" aria-labelledby="orders-heading">
          <div class="section-title-row">
            <div>
              <div class="eyebrow">Purchase History</div>
              <h2 class="display" id="orders-heading">Your Orders</h2>
            </div>
            <a class="continue-link" href="/shop">Continue shopping</a>
          </div>

          {customer.orders.nodes.length ? (
            <div class="orders-list">
              {customer.orders.nodes.map((order) => (
                <article class="order-card">
                  <div class="order-card-head">
                    <div>
                      <h3>{order.name}</h3>
                      <div class="order-date">{date(order.processedAt)}</div>
                    </div>
                    <strong>{money(order.totalPrice)}</strong>
                  </div>
                  <div class="order-statuses">
                    {order.financialStatus && <span>{friendlyStatus(order.financialStatus)}</span>}
                    {order.fulfillmentStatus && <span>{friendlyStatus(order.fulfillmentStatus)}</span>}
                  </div>
                  {order.lineItems.nodes.length > 0 && (
                    <div class="order-items" aria-label={`Items in ${order.name}`}>
                      {order.lineItems.nodes.map((item) => (
                        <div class="order-item">
                          <div class="order-item-image">
                            {item.image?.url ? <img src={item.image.url} alt={item.image.altText || item.title} loading="lazy" /> : <span>VNH</span>}
                          </div>
                          <div><strong>{item.title}</strong><span>Qty {item.quantity}</span></div>
                        </div>
                      ))}
                    </div>
                  )}
                  <a class="primary-button" href={order.statusPageUrl} target="_blank" rel="noopener noreferrer">View order status</a>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state"><h3>No orders yet.</h3><p>When you place an order, it will appear here.</p><a class="primary-button" href="/shop">Shop VNH</a></div>
          )}
        </section>
      </>
    ) : (
      <section class="signin-shell">
        <div class="eyebrow">VNH Account</div>
        <h1 class="display">Your Account</h1>
        <p>Sign in to securely view your VNH orders and account information.</p>
        {loginFailed && <p class="account-error">The Shopify sign-in did not complete. Please try again.</p>}
        {accountError && <p class="account-error">{accountError}</p>}
        <div class="signin-actions">
          <a class="primary-button" href={configured ? '/api/shopify/account/login?returnTo=/account' : hostedCustomerAccountUrl}>
            Sign in to VNH
          </a>
          <a class="secondary-button" href="/shop">Continue shopping</a>
        </div>
        {!configured && <p class="setup-note">Account sign-in is securely handled by Shopify while the native VNH account connection is being enabled.</p>}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .account-page{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(76px,9vw,124px)}
  .breadcrumbs{display:flex;gap:9px;align-items:center;margin-bottom:clamp(24px,4vw,42px);font-size:.78rem;color:#9ea6ad}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover,.breadcrumbs a:focus-visible{color:#fff}
  .signin-shell,.empty-state{max-width:820px;padding:clamp(30px,6vw,64px);border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.03)}.signin-shell h1{margin:.5rem 0 18px;font-size:clamp(3rem,7vw,6rem)}.signin-shell>p{color:#c6cbd0;max-width:620px;line-height:1.7}.signin-actions,.account-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .primary-button,.secondary-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;text-decoration:none;font:800 .73rem/1 Oxanium,sans-serif;letter-spacing:.09em;text-transform:uppercase;border:1px solid #fff}.primary-button{background:#fff;color:#0b0d0f}.primary-button:hover,.primary-button:focus-visible{background:transparent;color:#fff}.secondary-button{background:transparent;color:#fff;border-color:rgba(255,255,255,.32)}.secondary-button:hover,.secondary-button:focus-visible{border-color:#fff;background:rgba(255,255,255,.07)}
  .setup-note,.account-error{font-size:.8rem!important}.account-error{color:#e5a998!important}.setup-note{color:#879099!important}
  .account-header{display:flex;align-items:end;justify-content:space-between;gap:28px;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.12)}.account-header h1{margin:.4rem 0 8px;font-size:clamp(3rem,6vw,5.6rem)}.account-header p{margin:0;color:#aeb5bc}.account-actions{margin:0}
  .orders-section{padding-top:44px}.section-title-row{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.section-title-row h2{margin:.35rem 0 0;font-size:clamp(2.4rem,5vw,4.5rem)}.continue-link{color:#c5cbd0;border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:3px}
  .orders-list{display:grid;gap:16px}.order-card{padding:24px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.025)}.order-card-head{display:flex;align-items:start;justify-content:space-between;gap:20px}.order-card h3{margin:0;font:800 1.3rem/1 Oxanium,sans-serif}.order-date{margin-top:7px;color:#8f979e;font-size:.82rem}.order-card-head>strong{font-size:1.1rem}.order-statuses{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.order-statuses span{padding:6px 9px;border:1px solid rgba(255,255,255,.15);font-size:.67rem;letter-spacing:.07em;text-transform:uppercase;color:#c7cdd1}
  .order-items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0 22px}.order-item{display:flex;gap:10px;min-width:0;align-items:center}.order-item-image{width:58px;height:58px;flex:0 0 58px;display:grid;place-items:center;background:#0b0d0f;border:1px solid rgba(255,255,255,.1);overflow:hidden}.order-item-image img{width:100%;height:100%;object-fit:contain}.order-item-image span{font:800 .7rem/1 Oxanium,sans-serif;color:#6f777d}.order-item strong{display:block;font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.order-item span{display:block;color:#8f979e;font-size:.72rem;margin-top:4px}
  .empty-state h3{margin:0 0 8px;font:800 1.4rem/1.2 Oxanium,sans-serif}.empty-state p{color:#aeb5bc;margin:0 0 20px}
  @media(max-width:900px){.account-header,.section-title-row{align-items:flex-start;flex-direction:column}.order-items{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.signin-actions,.account-actions{flex-direction:column}.primary-button,.secondary-button{width:100%;box-sizing:border-box}.order-items{grid-template-columns:1fr}.order-card-head{align-items:flex-start;flex-direction:column}}
</style>
