{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vnh-official-site",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": ["BREVO_API_KEY"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
