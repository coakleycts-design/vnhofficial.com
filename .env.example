# VNH Sanity CMS
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Search verification (optional)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 (optional; public measurement ID such as G-XXXXXXXXXX)
PUBLIC_GA4_MEASUREMENT_ID=

# Shopify Storefront API
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Shopify Customer Account API (optional until native accounts are enabled)
# Configure this client under Shopify Admin -> Headless -> VNH storefront -> Customer Account API.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only set this if the Shopify client type is confidential.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Brevo
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VNH
CONTACT_TO_EMAIL=vnhsupport@vnhofficial.com
